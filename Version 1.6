function pickImg(max,type,q,cb){
  const i=document.createElement('input');i.type='file';i.accept='image/*';
  i.onchange=()=>{const f=i.files[0];if(f)readImg(f,max,type,q,cb)};i.click();
}
function readImg(f,max,type,q,cb){
  if(!f||!/^image\//.test(f.type))return toast('Please choose an image file');
  const r=new FileReader();
  r.onload=()=>{const im=new Image();
    im.onload=()=>{
      const k=Math.min(1,max/Math.max(im.width,im.height));
      const c=document.createElement('canvas');c.width=im.width*k|0;c.height=im.height*k|0;
      c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL(type,q));
    };
    im.onerror=()=>toast("That image couldn't be read");
    im.src=r.result};
  r.readAsDataURL(f);
}
