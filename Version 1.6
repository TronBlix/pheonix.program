function buildCloakPage(){
  syncSeed();
  const seedObj={};
  for(const k of Object.keys(mem)) seedObj[k]=mem[k];
  // Prevent infinite auto-cloak in the new tab
  try{
    const c=JSON.parse(seedObj.cfg||'{}');
    c.auto='off';
    seedObj.cfg=JSON.stringify(c);
  }catch(e){}
  const seedFinal=JSON.stringify(seedObj).replace(/</g,'\u003c');
  let page=document.documentElement.outerHTML;
  page=page.replace(/<script>window\.__SEED=[\s\S]*?<\/script>/g,'');
  if(/<head[^>]*>/i.test(page)) page=page.replace(/<head[^>]*>/i, m=>m+'<script>window.__SEED='+seedFinal+'<\/script>');
  else page='<head><script>window.__SEED='+seedFinal+'<\/script></head>'+page;
  return '<!DOCTYPE html>'+page;
}
function cloakTab(mode){
  const full=buildCloakPage();
  if(mode==='blob'){
    const u=URL.createObjectURL(new Blob([full],{type:'text/html'}));
    return !!open(u,'_blank');
  }
  // about:blank — write the full document (more reliable than iframe)
  const w=open('about:blank','_blank');
  if(!w) return false;
  try{
    w.document.open();
    w.document.write(full);
    w.document.close();
    try{w.focus()}catch(e){}
    return true;
  }catch(err){
    try{
      const u=URL.createObjectURL(new Blob([full],{type:'text/html'}));
      w.location.href=u;
      return true;
    }catch(e2){return false}
  }
}
