    }
  },
  /* Soft falling snow */
  snow(c,w,h,t,a,m,L){
    const u=UN(w,h);
    const g=c.createLinearGradient(0,0,0,h);
    g.addColorStop(0,`rgba(110,165,205,${L?.2:.38})`);g.addColorStop(1,`rgba(215,232,245,${L?.25:.2})`);
    c.fillStyle=g;c.fillRect(0,0,w,h);
    const col=L?'80,115,165':'255,255,255';
    for(let i=0;i<110;i++){
      const p=PT[i],ph=(t*(.04+.09*p.z)+p.y)%1,y=ph*(h+10*u)-5*u,x=((p.x*w+Math.sin(t*.6+p.p)*18*u)%w+w)%w;
      c.fillStyle=`rgba(${col},${Math.min(1,(.4+.5*p.z)*m)})`;c.beginPath();c.arc(x,y,(.9+2.3*p.z)*u,0,7);c.fill();
    }
  },
  /* Drifting, pulsing lights */
  fireflies(c,w,h,t,a,m,L){
    const u=UN(w,h);
    const g=c.createLinearGradient(0,0,0,h);g.addColorStop(0,'rgba(8,30,20,0)');g.addColorStop(1,'rgba(10,55,28,.55)');
    c.fillStyle=g;c.fillRect(0,0,w,h);
    for(let i=0;i<46;i++){
      const p=PT[i+20],x=w*(p.x+Math.sin(t*.15*(.5+p.z)+p.p)*.06),y=h*(.12+p.y*.85+Math.cos(t*.2*(.5+p.z)+p.p*2)*.05);
      const pu=.5+.5*Math.sin(t*(.8+p.z*1.4)+p.p*3),r=(1.2+p.z*1.8)*u;
      const gg=c.createRadialGradient(x,y,0,x,y,r*7);gg.addColorStop(0,`rgba(215,255,110,${Math.min(1,.8*pu*m)})`);gg.addColorStop(1,'rgba(215,255,110,0)');
      c.fillStyle=gg;c.beginPath();c.arc(x,y,r*7,0,7);c.fill();
      c.fillStyle=`rgba(255,255,205,${Math.min(1,pu*m)})`;c.beginPath();c.arc(x,y,r*.7,0,7);c.fill();
    }
  },
  /* Big slow blobs of color */
  lava(c,w,h,t,a,m,L){
    c.globalCompositeOperation=L?'source-over':'lighter';
    const rgb=hexRGB(a);
    [rgb,'255,95,162','255,179,71','106,92,255',rgb,'56,189,248'].forEach((col,i)=>{
      const cx=w*(.5+.38*Math.sin(t*(.17+i*.05)+i*1.9)),cy=h*(.5+.36*Math.cos(t*(.13+i*.04)+i*2.3));
      const rad=Math.max(w,h)*(.2+.05*Math.sin(t*.3+i));
