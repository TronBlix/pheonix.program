      g.addColorStop(0,`rgba(${col},${.65*m*(L?.7:1)})`);g.addColorStop(.62,`rgba(${col},${.5*m*(L?.7:1)})`);g.addColorStop(1,`rgba(${col},0)`);
      c.fillStyle=g;c.fillRect(0,0,w,h);
    });
    c.globalCompositeOperation='source-over';
  },
  /* A drifting color wash (follows accent) */
  gradient(c,w,h,t,a,m,L){
    const rgb=hexRGB(a),ang=t*.12,x=Math.cos(ang)*w*.6,y=Math.sin(ang)*h*.6;
    let g=c.createLinearGradient(w/2-x,h/2-y,w/2+x,h/2+y);
    g.addColorStop(0,`rgba(${rgb},${.55*m})`);g.addColorStop(.5,`rgba(124,108,255,${.45*m})`);g.addColorStop(1,`rgba(255,122,89,${.5*m})`);
    c.fillStyle=g;c.fillRect(0,0,w,h);
    const gx=w*(.5+.35*Math.sin(t*.3)),gy=h*(.5+.3*Math.cos(t*.23));
    g=c.createRadialGradient(gx,gy,0,gx,gy,Math.max(w,h)*.55);
    g.addColorStop(0,`rgba(255,255,255,${.2*m})`);g.addColorStop(1,'rgba(255,255,255,0)');
    c.fillStyle=g;c.fillRect(0,0,w,h);
  }
};

