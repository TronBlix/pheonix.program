};


/* ===== Backgrounds =====
   Every scene is a pure function of time: SC[id](ctx, width, height, seconds, accentHex, strength, isLight).
   The page background and the live previews in Settings use exactly the same functions. */
const BGS=[
  {id:'aurora',name:'Aurora',tag:'Colorful'},
  {id:'embers',name:'Embers',tag:'Warm'},
  {id:'waves',name:'Waves',tag:'Calm'},
  {id:'nebula',name:'Nebula',tag:'Space'},
  {id:'synth',name:'Synthwave',tag:'Retro'},
  {id:'matrix',name:'Matrix',tag:'Code rain'},
  {id:'rain',name:'Rain',tag:'Moody'},
  {id:'lava',name:'Lava lamp',tag:'Chill'},
  {id:'snow',name:'Snowfall',tag:'Cozy'},
  {id:'fireflies',name:'Fireflies',tag:'Night'},
  {id:'gradient',name:'Gradient',tag:'Smooth'}
];
const BGMIG={particles:'embers',stars:'nebula',orbs:'lava',mesh:'gradient',grid:'synth',off:'plain'};
function bgNorm(b){b=BGMIG[b]||b;return(b==='image'||b==='plain'||BGS.some(x=>x.id===b))?b:'aurora'}

const rng=s=>()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
const RND=rng(7);
const PT=Array.from({length:160},()=>({x:RND(),y:RND(),z:RND(),p:RND()*6.283}));
const hexRGB=h=>{h=String(h).replace('#','');if(h.length===3)h=[...h].map(c=>c+c).join('');const n=parseInt(h,16)||0;return(n>>16)+','+(n>>8&255)+','+(n&255)};
const UN=(w,h)=>Math.min(1,Math.max(.45,Math.max(w,h)/900));

const SC={
  /* Colorful curtains of light */
  aurora(c,w,h,t,a,m,L){
    c.globalCompositeOperation=L?'source-over':'lighter';
    [[52,211,153],[34,211,238],[167,139,250]].forEach((col,i)=>{
      const base=h*(.2+i*.13),amp=h*.11,n=40;
      c.beginPath();
      for(let k=0;k<=n;k++){const x=w*k/n,y=base+Math.sin(k*.33+t*.45+i*1.7)*amp+Math.sin(k*.85-t*.3+i)*amp*.4;k?c.lineTo(x,y):c.moveTo(x,y)}
      for(let k=n;k>=0;k--){c.lineTo(w*k/n,base+h*.4+Math.sin(k*.3+t*.35+i)*amp*.7)}
      c.closePath();
      const g=c.createLinearGradient(0,base-amp*2.2,0,base+h*.45);
      g.addColorStop(0,`rgba(${col},0)`);g.addColorStop(.4,`rgba(${col},${(L?.24:.28)*m})`);g.addColorStop(1,`rgba(${col},0)`);
      c.fillStyle=g;c.fill();
    });
    c.globalCompositeOperation='source-over';
  },
  /* Rising sparks over a warm glow */
  embers(c,w,h,t,a,m,L){
    const u=UN(w,h);
    const g=c.createLinearGradient(0,h,0,h*.3);
    g.addColorStop(0,`rgba(255,90,20,${.4*m})`);g.addColorStop(.5,`rgba(255,60,10,${.1*m})`);g.addColorStop(1,'rgba(255,60,10,0)');
    c.fillStyle=g;c.fillRect(0,0,w,h);
    for(let i=0;i<120;i++){
      const p=PT[i],sp=.05+.11*p.z,life=(t*sp+p.y)%1;
      const y=h*(1.05-life*1.15),x=w*p.x+Math.sin(t*(.6+p.z)+p.p)*20*u*(.4+life);
      const r=(.9+2.4*p.z)*u*(1-life*.55),al=(1-life)*(.55+.45*Math.sin(t*5+p.p))*m;
      const col=life<.3?'255,205,90':life<.62?'255,125,35':'225,55,25';
      c.fillStyle=`rgba(${col},${al*.18})`;c.beginPath();c.arc(x,y,r*3.2,0,7);c.fill();
      c.fillStyle=`rgba(${col},${Math.min(1,al)})`;c.beginPath();c.arc(x,y,r,0,7);c.fill();
    }
  },
  /* Layered ocean swells (follows accent) */
  waves(c,w,h,t,a,m,L){
    const rgb=hexRGB(a),u=UN(w,h);
    for(let i=0;i<5;i++){
      const y0=h*(.4+i*.13),amp=h*(.03+i*.008),sp=.5+i*.18,f=2.2+i*.5;
      c.beginPath();
      for(let x=0;x<=w;x+=5){const y=y0+Math.sin(x/w*f*6.283+t*sp+i*1.3)*amp+Math.sin(x/w*f*2.1*6.283-t*sp*.7)*amp*.4;x?c.lineTo(x,y):c.moveTo(x,y)}
      c.strokeStyle=`rgba(${rgb},${Math.min(1,.7*m)})`;c.lineWidth=Math.max(1,1.4*u);c.stroke();
      c.lineTo(w,h);c.lineTo(0,h);c.closePath();
      const g=c.createLinearGradient(0,y0-amp,0,h);
      g.addColorStop(0,`rgba(${rgb},${(.26+i*.05)*m})`);g.addColorStop(1,`rgba(${rgb},${.05*m})`);
      c.fillStyle=g;c.fill();
    }
  },
  /* Deep space: colored clouds, twinkling stars, a shooting star */
  nebula(c,w,h,t,a,m,L){
    const u=UN(w,h);
    [[.25,.35,'124,58,237',.6],[.75,.3,'56,189,248',.5],[.55,.82,'236,72,153',.45]].forEach(([x,y,col,r],i)=>{
      const cx=(x+Math.sin(t*.12+i*2)*.08)*w,cy=(y+Math.cos(t*.1+i)*.06)*h,rad=Math.max(w,h)*r;
      const g=c.createRadialGradient(cx,cy,0,cx,cy,rad);
      g.addColorStop(0,`rgba(${col},${.4*m})`);g.addColorStop(1,`rgba(${col},0)`);
      c.fillStyle=g;c.fillRect(0,0,w,h);
    });
    const sc=L?'40,34,100':'255,255,255';
    for(let i=0;i<150;i++){
      const p=PT[i],x=((p.x*w-t*(2+p.z*8)*u)%w+w)%w,tw=.45+.55*Math.sin(t*(1+p.z*2)+p.p);
      c.fillStyle=`rgba(${sc},${Math.min(1,(.3+.6*p.z)*tw*m)})`;c.beginPath();c.arc(x,p.y*h,(.5+p.z*1.5)*u,0,7);c.fill();
    }
    const ph=(t*.22)%1;
    if(ph<.12){
      const k=ph/.12,x=w*.85-k*w*.5,y=h*.08+k*h*.4,gr=c.createLinearGradient(x,y,x+w*.12,y-h*.09);
      gr.addColorStop(0,`rgba(${sc},${.95*(1-k)})`);gr.addColorStop(1,`rgba(${sc},0)`);
      c.strokeStyle=gr;c.lineWidth=Math.max(1,1.8*u);c.beginPath();c.moveTo(x,y);c.lineTo(x+w*.12,y-h*.09);c.stroke();
    }
  },
  /* Retro sunset with a scrolling neon grid */
  synth(c,w,h,t,a,m,L){
    const hz=h*.56,u=UN(w,h);
    let g=c.createLinearGradient(0,0,0,hz);
    g.addColorStop(0,'rgba(45,12,100,.7)');g.addColorStop(1,'rgba(255,46,151,.45)');
    c.fillStyle=g;c.fillRect(0,0,w,hz);
    const sr=h*.25,sx=w/2,sy=hz-sr*.1;
    g=c.createLinearGradient(0,sy-sr,0,sy+sr);g.addColorStop(0,'rgba(255,220,110,.95)');g.addColorStop(1,'rgba(255,46,151,.95)');
    c.save();c.beginPath();c.rect(0,0,w,hz);c.clip();
    c.fillStyle=g;c.beginPath();c.arc(sx,sy,sr,0,7);c.fill();
    c.globalCompositeOperation='destination-out';
    for(let i=0;i<6;i++)c.fillRect(sx-sr,sy+sr*(.02+i*.16),sr*2,sr*(.025+i*.013));
    c.restore();
    g=c.createLinearGradient(0,hz,0,h);g.addColorStop(0,'rgba(20,4,45,.8)');g.addColorStop(1,'rgba(70,12,100,.55)');
    c.fillStyle=g;c.fillRect(0,hz,w,h-hz);
    c.strokeStyle=`rgba(255,80,200,${Math.min(1,.75*m)})`;c.lineWidth=Math.max(.9,1.2*u);
    const cx=w/2;
    for(let i=-14;i<=14;i++){c.beginPath();c.moveTo(cx+i*w*.012,hz);c.lineTo(cx+i*w*.2,h);c.stroke()}
    const N=9,off=(t*.35)%1;
    for(let j=0;j<N;j++){const f=(j+off)/N,y=hz+(h-hz)*f*f;c.beginPath();c.moveTo(0,y);c.lineTo(w,y);c.stroke()}
    c.strokeStyle=`rgba(80,220,255,${Math.min(1,.9*m)})`;c.beginPath();c.moveTo(0,hz);c.lineTo(w,hz);c.stroke();
  },
  /* Falling code (follows accent) */
  matrix(c,w,h,t,a,m,L){
    const u=UN(w,h),fs=Math.max(6,11*u),cols=Math.ceil(w/fs),rgb=hexRGB(a);
    c.font=fs+'px ui-monospace,Menlo,Consolas,monospace';c.textBaseline='top';
    const ch='01<>/\\{}[]=+*#$%&?ABCDEFXYZ';
    for(let i=0;i<cols;i++){
      const sp=.2+((i*37)%11)/11*.4,len=8+(i*13)%12,rows=h/fs;
      const head=((t*sp+((i*53)%100)/100)%1.5)*(rows+len)-len;
      for(let k=0;k<len;k++){
        const row=Math.floor(head)-k;if(row<0||row*fs>h)continue;
        const al=Math.min(1,(1-k/len)*.7*m);
        c.fillStyle=k===0?(L?`rgba(${rgb},${Math.min(1,.95*m)})`:`rgba(255,255,255,${Math.min(1,.9*m)})`):`rgba(${rgb},${al})`;
        c.fillText(ch[(i*7+row*13+Math.floor(t*(k===0?8:1.5)))%ch.length],i*fs,row*fs);
      }
    }
  },
  /* Slanted rain over a stormy tint */
  rain(c,w,h,t,a,m,L){
    const u=UN(w,h);
    const g=c.createLinearGradient(0,0,0,h);
    g.addColorStop(0,`rgba(30,50,95,${L?.16:.42})`);g.addColorStop(1,`rgba(80,110,160,${L?.22:.22})`);
    c.fillStyle=g;c.fillRect(0,0,w,h);
    c.lineWidth=Math.max(.9,1.1*u);
    const col=L?'40,90,160':'175,205,255';
    for(let i=0;i<130;i++){
      const p=PT[i],sp=.8+p.z*1.1,ph=(t*sp+p.p/6.283)%1,len=(10+p.z*24)*u;
      const y=ph*(h+len*2)-len,x=(p.x*w+ph*h*.14)%w;
