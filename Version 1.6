/* ===== Proxy tool: in-browser proxy pipeline ===== */
const PXD={block:'doubleclick.net\ngooglesyndication.com\nadservice.google.com',allow:'wikipedia.org\nwikimedia.org',allowOnly:false,strip:true,https:true,ttl:300,isolate:'strict'};
let PXS=Object.assign({},PXD,S.get('px',{}));
const PXC=new Map(),PXL=[],PXT={req:0,hit:0,miss:0,blocked:0,err:0};
let pxMode='search',pxReady=false,pxLastTrace=null;
const pxSave=()=>S.set('px',PXS);
const pxList=t=>String(t||'').split(/[\n,]+/).map(x=>x.trim().toLowerCase()).filter(Boolean);
const pxMatch=(h,l)=>l.some(d=>h===d||h.endsWith('.'+d));
const pxB=n=>n<1024?n+' B':(n/1024).toFixed(1)+' KB';
const pxEl=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e};
const PXMODES=[
  ['search','Search','Look up a topic through Wikipedia’s open API.','Best for: seeing the full proxy pipeline','search'],
  ['url','Fetch URL','The proxy requests a page for you and shows a clean reader view.','Best for: reading a page without ads or scripts','doc'],
  ['frame','Frame','Show a site live in a sandboxed window.','Best for: sites that won’t let the proxy read them','frame']
];
const PXPH={search:'Search a topic…',url:'Enter a URL, e.g. https://en.wikipedia.org/wiki/Proxy_server',frame:'Enter a URL to embed, e.g. https://en.m.wikipedia.org/wiki/Proxy_server'};
const PXEX=[
  ['Search: solar system','search','solar system'],
  ['Fetch an article','url','https://en.wikipedia.org/api/rest_v1/page/summary/Proxy_server'],
  ['Fetch a page (reader view)','url','https://en.wikipedia.org/wiki/Cache_(computing)'],
  ['See a block','url','https://doubleclick.net/'],
  ['See a CORS failure','url','https://www.example.com/'],
  ['Frame Wikipedia','frame','https://en.m.wikipedia.org/wiki/Proxy_server']
];

function pxFinish(ent,trace,t0,result,data,err,extra){
  ent.ms=Math.round(performance.now()-t0);ent.result=result;
  if(result==='ERROR')PXT.err++;
  PXL.unshift(ent);if(PXL.length>100)PXL.pop();
  pxLastTrace=trace;
  if(pxReady){pxRenderTrace();pxRenderLog();pxRenderStats()}
  return Object.assign({ok:['HIT','FETCHED','FRAME'].includes(result),result,data,error:err},extra||{});
}

async function pxRequest(raw,kind){
  const t0=performance.now(),trace=[],ent={t:new Date(),kind,url:String(raw),result:'',ms:0,note:''};
  const step=(name,state,detail)=>trace.push({name,state,detail});
  PXT.req++;
  let u;
  try{
    let x=String(raw).trim();
    if(!/^[a-z][a-z0-9+.-]*:/i.test(x))x='https://'+x;
    u=new URL(x);
    if(!/^https?:$/.test(u.protocol))throw new Error('Only http and https URLs are supported');
    const notes=[];
    if(PXS.https&&u.protocol==='http:'){u.protocol='https:';notes.push('upgraded http to https')}
    if(PXS.strip){
      const rm=[...u.searchParams.keys()].filter(k=>/^(utm_|fbclid|gclid|msclkid|mc_eid|igshid)/i.test(k));
      rm.forEach(k=>u.searchParams.delete(k));
      if(rm.length)notes.push('removed tracking parameters: '+rm.join(', '));
    }
    step('1 Normalize','ok',(notes.length?notes.join('; '):'URL was already clean')+'. Result: '+u.href);
  }catch(e){
    step('1 Normalize','fail','That is not a usable URL ('+e.message+')');
    step('2 Rules','skip','Not reached');step('3 Cache','skip','Not reached');step('4 Fetch','skip','Not reached');step('5 Transform','skip','Not reached');
    step('6 Log','ok','Recorded as an error');
    return pxFinish(ent,trace,t0,'ERROR',null,'That does not look like a valid URL.');
  }
  const host=u.hostname.toLowerCase(),bl=pxList(PXS.block),al=pxList(PXS.allow);
  const skipRest=(from)=>{['3 Cache','4 Fetch','5 Transform'].slice(from).forEach(n=>step(n,'skip','Not reached because the request was stopped'))};
  if(pxMatch(host,bl)){
    PXT.blocked++;
    step('2 Rules','fail','BLOCKED: "'+host+'" is on your blocklist, so the site was never contacted');
    skipRest(0);step('6 Log','ok','Recorded as BLOCKED');
    return pxFinish(ent,trace,t0,'BLOCKED',null,'Blocked by your rules: '+host+' is on the blocklist. No connection was made.');
  }
  if(PXS.allowOnly&&!pxMatch(host,al)){
    PXT.blocked++;
    step('2 Rules','fail','BLOCKED: allowlist mode is on and "'+host+'" is not on the allowlist');
    skipRest(0);step('6 Log','ok','Recorded as BLOCKED');
    return pxFinish(ent,trace,t0,'BLOCKED',null,'Blocked by your rules: allowlist mode is on and '+host+' is not allowed.');
  }
  step('2 Rules','ok',PXS.allowOnly?'"'+host+'" is on the allowlist':'"'+host+'" is not on the blocklist');
  if(kind==='frame'){
    step('3 Cache','skip','Frames are loaded by the browser itself, so there is nothing to store');
    step('4 Fetch','skip','Handed to the browser, which connects to the site directly');
    step('5 Transform','skip','The proxy never sees a frame’s content, so it can’t clean it');
    step('6 Log','ok','Recorded as FRAME');
    return pxFinish(ent,trace,t0,'FRAME',{url:u.href});
  }
  const key=u.href,c=PXC.get(key);
  if(PXS.ttl>0&&c&&Date.now()-c.at<PXS.ttl*1000){
    PXT.hit++;
    step('3 Cache','ok','HIT: this exact request was answered '+Math.round((Date.now()-c.at)/1000)+'s ago, so it is served from memory');
    step('4 Fetch','skip','Not needed, no network request was made');
    step('5 Transform','skip','Already done when it was first fetched');
    step('6 Log','ok','Recorded as HIT');
    return pxFinish(ent,trace,t0,'HIT',c.data);
  }
  PXT.miss++;
  step('3 Cache','ok',PXS.ttl>0?'MISS: not stored yet, or older than the '+PXS.ttl+'s TTL':'Cache is off (TTL 0), so every request goes to the site');
  let res,text,tm;
  try{
    const ac=new AbortController();tm=setTimeout(()=>ac.abort(),9000);
    res=await fetch(u.href,{signal:ac.signal,credentials:'omit',referrerPolicy:'no-referrer',cache:'no-store'});
    text=await res.text();clearTimeout(tm);
    step('4 Fetch',res.ok?'ok':'fail','Sent without cookies or referrer. The site replied HTTP '+res.status+' ('+pxB(text.length)+')');
    if(!res.ok){
      step('5 Transform','skip','Not reached');step('6 Log','ok','Recorded as an error');
      return pxFinish(ent,trace,t0,'ERROR',null,'The site answered with HTTP '+res.status+'.');
    }
  }catch(e){
    clearTimeout(tm);
    const timeout=e&&e.name==='AbortError';
    step('4 Fetch','fail',timeout?'No reply within 9 seconds':'The browser refused to let this page read the response. This is almost always CORS: the site has not given other pages permission to read it, and this is a browser rule a one-file page can’t override');
    step('5 Transform','skip','Not reached');step('6 Log','ok','Recorded as an error');
    return pxFinish(ent,trace,t0,'ERROR',null,timeout?'The request timed out.':'The browser blocked the read (CORS). The site doesn’t allow other pages to read it directly.',{cors:!timeout});
  }
  const ct=res.headers.get('content-type')||'';
  let data;
  if(/json/i.test(ct)){
    try{data={type:'json',json:JSON.parse(text)};step('5 Transform','ok','Parsed as JSON')}
    catch(e){data={type:'text',text:text.slice(0,20000)};step('5 Transform','ok','Looked like JSON but was not valid, shown as text')}
  }else if(/html/i.test(ct)){
    data=pxReader(text,u);
    const r=data.removed;
    step('5 Transform','ok','Built a reader view. Removed '+r.scripts+' scripts, '+r.styles+' stylesheets, '+r.frames+' frames/embeds, '+r.images+' images and '+r.handlers+' inline event handlers');
  }else{
    data={type:'text',text:text.slice(0,20000)};step('5 Transform','ok','Not HTML or JSON, shown as plain text');
  }
  if(PXS.ttl>0){PXC.set(key,{at:Date.now(),data});if(PXC.size>50)PXC.delete(PXC.keys().next().value)}
  step('6 Log','ok','Recorded as FETCHED');
  ent.note=pxB(text.length);
  return pxFinish(ent,trace,t0,'FETCHED',data);
}

function pxReader(html,u){
  const doc=new DOMParser().parseFromString(html,'text/html');
  const q=sel=>doc.querySelectorAll(sel).length;
  const removed={scripts:q('script'),styles:q('style,link[rel~=stylesheet]'),frames:q('iframe,object,embed,frame'),images:q('img,picture,video,audio'),handlers:0};
  doc.querySelectorAll('*').forEach(e=>[...e.attributes].forEach(a=>{if(/^on/i.test(a.name))removed.handlers++}));
  doc.querySelectorAll('script,style,noscript,iframe,object,embed,nav,footer,header,aside,form').forEach(e=>e.remove());
  const title=(doc.title||'').trim()||u.hostname;
  const blocks=[];
  doc.querySelectorAll('h1,h2,h3,p,li,blockquote,pre').forEach(e=>{
    const t=e.textContent.replace(/\s+/g,' ').trim();
    if(t.length>1&&blocks.length<120)blocks.push({tag:e.tagName.toLowerCase(),text:t.slice(0,600)});
  });
  const links=[],seen=new Set();
  doc.querySelectorAll('a[href]').forEach(a=>{
    try{
      const h=new URL(a.getAttribute('href'),u.href);
      const t=a.textContent.replace(/\s+/g,' ').trim();
      if(!/^https?:$/.test(h.protocol)||!t||seen.has(h.href)||links.length>=15)return;
      seen.add(h.href);links.push({text:t.slice(0,80),href:h.href});
    }catch(e){}
  });
  return {type:'page',title,blocks,links,removed,url:u.href};
}

/* ---- UI ---- */
function pxOut(){const o=$('#pxout');o.innerHTML='';return o}
function pxError(r,url){
  const o=pxOut(),b=pxEl('div','px-err');
  b.append(pxEl('b',null,r.result==='BLOCKED'?'Request blocked':'Request failed'),pxEl('br'),document.createTextNode(r.error||'Something went wrong.'));
  if(r.cors){
    b.append(pxEl('br'),pxEl('br'),document.createTextNode('Next step: use Frame mode. The browser can show this site in a window even though it won’t let this page read it.'));
    const row=pxEl('div','px-btns'),bt=pxEl('button','btn','Open in Frame mode');bt.type='button';bt.onclick=()=>pxSetMode('frame',url,true);row.append(bt);b.append(row);
  }
  o.append(b);
}
async function pxSearch(q){
  const url='https://en.wikipedia.org/w/api.php?action=query&list=search&srlimit=8&format=json&origin=*&srsearch='+encodeURIComponent(q);
  const r=await pxRequest(url,'search');
  if(!r.ok)return pxError(r,url);
  const o=pxOut(),list=(r.data.json&&r.data.json.query&&r.data.json.query.search)||[];
  o.append(pxEl('div','meta','Results for “'+q+'” from Wikipedia ('+r.result+')'));
  if(!list.length){o.append(pxEl('p',null,'No results.'));return}
  list.forEach(it=>{
    const d=pxEl('div','px-item'),a=pxEl('button','px-link',it.title);a.type='button';
    a.onclick=()=>pxSummary(it.title);
    const sn=new DOMParser().parseFromString(it.snippet,'text/html').body.textContent;
    d.append(a,pxEl('p',null,sn+'…'));o.append(d);
  });
  o.append(pxEl('div','meta','Click a result to fetch its summary through the proxy.'));
}
async function pxSummary(title){
  const url='https://en.wikipedia.org/api/rest_v1/page/summary/'+encodeURIComponent(title.replace(/ /g,'_'));
  const r=await pxRequest(url,'search');
  if(!r.ok)return pxError(r,url);
  const j=r.data.json||{},o=pxOut();
  o.append(pxEl('h4',null,j.title||title),pxEl('div','meta','Summary from Wikipedia ('+r.result+')'),pxEl('p',null,j.extract||'No summary available.'));
  const row=pxEl('div','px-btns'),fb=pxEl('button','btn','Open full article in Frame');fb.type='button';
  fb.onclick=()=>pxSetMode('frame','https://en.m.wikipedia.org/wiki/'+encodeURIComponent(title.replace(/ /g,'_')),true);
  const bk=pxEl('button','btn','Back to results');bk.type='button';bk.onclick=()=>pxSearch($('#pxq').value.trim()||title);
  row.append(fb,bk);o.append(row);
}
async function pxFetchUrl(raw){
  const r=await pxRequest(raw,'fetch');
  if(!r.ok)return pxError(r,raw);
  const d=r.data,o=pxOut();
  if(d.type==='json'){
    o.append(pxEl('h4',null,'JSON response'),pxEl('div','meta','Parsed by the proxy ('+r.result+')'));
    const pre=pxEl('pre',null,JSON.stringify(d.json,null,2).slice(0,6000));pre.style.cssText='white-space:pre-wrap;font-size:12px;margin-top:8px;max-height:360px;overflow:auto';o.append(pre);
  }else if(d.type==='page'){
    o.append(pxEl('h4',null,d.title),pxEl('div','meta','Reader view built by the proxy ('+r.result+'). Scripts, styles, frames and images were removed.'));
    d.blocks.forEach(b=>{const e=pxEl(/^h/.test(b.tag)?'h4':'p',null,b.text);o.append(e)});
    if(d.links.length){
      o.append(pxEl('div','meta','Links on this page (each opens through the proxy):'));
      d.links.forEach(l=>{const row=pxEl('div','px-item'),a=pxEl('button','px-link',l.text);a.type='button';a.onclick=()=>pxSetMode('url',l.href,true);row.append(a);o.append(row)});
    }
  }else{
    o.append(pxEl('h4',null,'Plain text response'));const pre=pxEl('pre',null,d.text);pre.style.cssText='white-space:pre-wrap;font-size:12px;max-height:360px;overflow:auto';o.append(pre);
  }
}
async function pxFrame(raw){
  const r=await pxRequest(raw,'frame');
  if(!r.ok)return pxError(r,raw);
  const o=pxOut();
  o.append(pxEl('div','meta','Frame mode: the rules were applied to the URL, then your browser loaded the site directly. The proxy can’t cache or clean this content. If the window below stays blank, the site refuses to be embedded.'));
  const f=document.createElement('iframe');f.className='px-frame';f.src=r.data.url;
  const strict=PXS.isolate!=='standard';
  f.setAttribute('sandbox',strict?'allow-scripts allow-popups':'allow-scripts allow-forms allow-popups allow-same-origin');
  f.referrerPolicy='no-referrer';f.title='Framed site';
  f.setAttribute('allow',"camera 'none'; microphone 'none'; geolocation 'none'; payment 'none'; usb 'none'; clipboard-read 'none'");
  if(strict)f.setAttribute('credentialless','');
  o.append(pxEl('div','meta','Isolation: '+(strict?'Strict. The framed page can’t read or set its own cookies or storage'+(('credentialless' in HTMLIFrameElement.prototype)?', and starts with an empty cookie jar.':'. (This browser doesn’t support credentialless frames, so the sandbox is the only barrier.)'):'Standard. The framed page may use its own cookies and storage. Change this under Privacy, Protection.')));
  o.append(f);
  const row=pxEl('div','px-btns'),a=pxEl('a','btn','Open in new tab');a.href=r.data.url;a.target='_blank';a.rel='noopener noreferrer';a.style.textDecoration='none';row.append(a);o.append(row);
}
function pxRun(){
  const v=$('#pxq').value.trim();if(!v)return;
  const o=pxOut();o.append(pxEl('span','meta','Working…'));
  if(pxMode==='search')pxSearch(v);else if(pxMode==='url')pxFetchUrl(v);else pxFrame(v);
}
function pxSetMode(m,val,run){
  pxMode=m;if(val!=null)$('#pxq').value=val;
  $('#pxq').placeholder=PXPH[m];pxRenderModes();
  if(run)pxRun();
}
function pxFromHome(q){
  pxInit();privTab('try');
  const isUrl=/^(https?:\/\/|www\.)/i.test(q)||/^[a-z0-9-]+\.[a-z]{2,}([/:].*)?$/i.test(q);
  pxSetMode(isUrl?'url':'search',q,true);
}
function pxRenderModes(){
  $('#pxm').innerHTML=PXMODES.map(m=>`<button type="button" class="opt ${pxMode===m[0]?'on':''}" data-m="${m[0]}"><b><svg class="i"><use href="#i-${m[4]}"/></svg>${m[1]}</b><small>${m[2]}</small><span class="when">${m[3]}</span></button>`).join('');
}
function pxRenderTrace(){
  const el=$('#pxtr');if(!pxLastTrace){return}
  el.innerHTML='';
  pxLastTrace.forEach(t=>{
    const row=pxEl('div','px-step'),ic=pxEl('div','px-ic '+t.state,t.state==='ok'?'✓':t.state==='fail'?'✕':'–');
    const body=pxEl('div');body.append(pxEl('b',null,t.name),pxEl('span',null,t.detail));
    row.append(ic,body);el.append(row);
  });
}
function pxRenderStats(){
  const rate=PXT.hit+PXT.miss?Math.round(PXT.hit/(PXT.hit+PXT.miss)*100)+'%':'–';
  $('#pxst').innerHTML=[['Requests',PXT.req],['Cache hits',PXT.hit],['Cache misses',PXT.miss],['Blocked',PXT.blocked],['Hit rate',rate]]
    .map(a=>`<div class="px-stat"><b>${a[1]}</b><span>${a[0]}</span></div>`).join('');
  $('#pxcn').textContent=PXC.size+' item'+(PXC.size===1?'':'s')+' stored';
}
function pxRenderLog(){
  const el=$('#pxlg');
  if(!PXL.length){el.innerHTML='<span class="meta">No requests yet.</span>';return}
  el.innerHTML=PXL.map(e=>`<div class="px-row"><span>${e.t.toTimeString().slice(0,8)}</span><span>${esc(e.kind)}</span><span class="px-badge ${e.result}">${e.result}</span><span class="u" title="${esc(e.url)}">${e.ms}ms · ${esc(e.url)}</span></div>`).join('');
}
function pxRenderRules(){
  $('#pxbl').value=PXS.block;$('#pxal').value=PXS.allow;
  $('#pxalw').style.display=PXS.allowOnly?'block':'none';
  const tg=[
    ['strip','Remove tracking parameters','Cleans <code>utm_</code>, <code>fbclid</code>, <code>gclid</code> and similar bits off URLs.'],
    ['https','Upgrade http to https','Use the encrypted version of a site whenever possible.'],
    ['allowOnly','Allowlist mode','Block every site except the ones on your allowlist. The strictest option.']
  ];
  $('#pxro').innerHTML=tg.map(t=>`<button type="button" class="tog ${PXS[t[0]]?'on':''}" data-t="${t[0]}"><span><b>${t[1]}</b><small>${t[2]}</small></span><i class="tsw"></i></button>`).join('');
  $('#pxtt').innerHTML=[[0,'Off'],[60,'1 min'],[300,'5 min'],[1800,'30 min']].map(a=>`<button type="button" class="opt c ${PXS.ttl===a[0]?'on':''}" data-ttl="${a[0]}">${a[1]}</button>`).join('');
}
function pxInit(){
  if(pxReady)return;pxReady=true;
  $('#pxm').onclick=e=>{const o=e.target.closest('[data-m]');if(o)pxSetMode(o.dataset.m)};
  $('#pxf').onsubmit=e=>{e.preventDefault();pxRun()};
  $('#pxex').innerHTML='<span>Try an example:</span>'+PXEX.map((x,i)=>`<button type="button" data-i="${i}">${esc(x[0])}</button>`).join('');
  $('#pxex').onclick=e=>{const b=e.target.closest('[data-i]');if(!b)return;const x=PXEX[+b.dataset.i];pxSetMode(x[1],x[2],true)};
  $('#pxbl').oninput=()=>{PXS.block=$('#pxbl').value;pxSave()};
  $('#pxal').oninput=()=>{PXS.allow=$('#pxal').value;pxSave()};
  $('#pxro').onclick=e=>{const o=e.target.closest('[data-t]');if(!o)return;PXS[o.dataset.t]=!PXS[o.dataset.t];pxSave();pxRenderRules()};
  $('#pxtt').onclick=e=>{const o=e.target.closest('[data-ttl]');if(!o)return;PXS.ttl=+o.dataset.ttl;pxSave();pxRenderRules()};
  $('#pxcc').onclick=()=>{PXC.clear();pxRenderStats()};
  $('#pxlc').onclick=()=>{PXL.length=0;pxRenderLog()};
  $('#pxle').onclick=()=>{try{navigator.clipboard.writeText(JSON.stringify(PXL,null,2));$('#pxle').textContent='Copied'}catch(e){}setTimeout(()=>$('#pxle').textContent='Copy log as JSON',1500)};
  pxRenderModes();pxRenderRules();pxRenderStats();pxRenderLog();pxRenderTrace();
  $('#pxq').placeholder=PXPH[pxMode];
}


/* ===== Security tab ===== */
const SEC_TRACKERS=['doubleclick.net','googlesyndication.com','adservice.google.com','google-analytics.com','googletagmanager.com','googletagservices.com','facebook.net','scorecardresearch.com','adnxs.com','criteo.com','taboola.com','outbrain.com','hotjar.com','quantserve.com','amazon-adsystem.com'];
const SEC_CSP_INFO={
  'default-src':'Starting point: everything is blocked unless a rule below allows it',
  'script-src':'Only code written inside this page may run. No external scripts.',
  'style-src':'Only styles written inside this page. No external stylesheets.',
  'img-src':'Images only from inside the page. No remote images or tracking pixels.',
  'font-src':'Fonts only from inside the page.',
  'connect-src':'Network requests (the proxy) may only use HTTPS.',
  'frame-src':'Frame mode may only embed HTTPS sites.',
  'base-uri':'Nobody can change how relative links are resolved.',
  'object-src':'Plugins (Flash, Java and similar) are disabled.',
  'form-action':'Forms cannot send data anywhere.',
  'worker-src':'Background workers are disabled.'
};
let secReady=false;const SECV=[];
function secPick(o){const r={};if(o&&typeof o==='object')for(const k of Object.keys(o)){if(k==='pin'||k==='__proto__'||!(k in cfg)||typeof o[k]!==typeof cfg[k])continue;r[k]=o[k]}return r}
document.addEventListener('securitypolicyviolation',e=>{
  SECV.unshift({t:new Date(),d:e.violatedDirective,u:e.blockedURI||'inline code'});if(SECV.length>30)SECV.pop();
  if(secReady)secRenderViol();
});
function secChecks(){
  const out=[],add=(name,state,detail)=>out.push({name,state,detail});
  const csp=document.querySelector('meta[http-equiv="Content-Security-Policy"]');
  add('Content Security Policy',csp?'ok':'warn',csp?'Active. The browser blocks external scripts, styles, images, plugins and form posts (details below).':'Missing. Nothing limits what this page may load.');
  add('Referrer policy',document.querySelector('meta[name="referrer"][content="no-referrer"]')?'ok':'warn','Sites you open or embed are not told where you came from.');
  const ext=document.querySelectorAll('script[src],link[rel~="stylesheet"],iframe[src]').length;
  add('No third-party code in the page',ext===0?'ok':'warn',ext===0?'No external scripts or stylesheets are loaded, so no outside company can run code here.':ext+' external resource(s) are loaded.');
  const pr=location.protocol;
  add('Connection',pr==='https:'?'ok':pr==='http:'?'warn':'info',pr==='https:'?'This page was delivered over HTTPS (encrypted).':pr==='http:'?'This page was delivered over plain HTTP, which can be read or altered in transit. Host it on HTTPS.':'Opened as a local file or in-memory page, so there is no network connection for the page itself.');
  let ck=[];try{ck=document.cookie?document.cookie.split(';').filter(c=>c.trim()):[]}catch(e){}
  add('Cookies set by this page',ck.length===0?'ok':'info',ck.length===0?'None. Phoenix stores settings in local storage instead of cookies.':ck.length+' cookie(s) present (see the audit below).');
  add('Proxy requests are cookie-free','ok','Fetch and Search send no cookies and accept none (credentials are omitted).');
  const strict=PXS.isolate!=='standard';
  add('Frame isolation',strict?'ok':'warn',strict?'Strict: framed sites can’t use their own cookies or storage.':'Standard: framed sites may use their own cookies. Switch to Strict below to block them.');
  const cl='credentialless' in HTMLIFrameElement.prototype;
  add('Empty cookie jar for frames',cl?'ok':'info',cl?'Supported: Strict frames start with no cookies.':'Not supported by this browser (it is a Chromium feature). Strict frames rely on the sandbox alone.');
  const nb=pxList(PXS.block).length;
  add('Tracker blocklist',nb>=5?'ok':'info',nb+' host(s) on the proxy blocklist.'+(nb<5?' Use the button below to add common trackers.':''));
  const pin=cfg.pin;
  add('PIN lock',!pin?'info':pin.startsWith('v2$')?'ok':'warn',!pin?'No PIN set. Optional; set one in Settings.':pin.startsWith('v2$')?'Set, stored as a salted PBKDF2 hash with attempt lockout.':'Set, but stored with an older, weaker method. Set it again in Settings to upgrade it.');
  add('Secure context (needed for strong hashing)',window.isSecureContext?'ok':'info',window.isSecureContext?'Yes.':'No, so PINs fall back to a weaker hash.');
  return out;
}
function secRender(){
  const c=secChecks(),scored=c.filter(x=>x.state!=='info'),pass=scored.filter(x=>x.state==='ok').length,warns=scored.length-pass;
  c.sort((a,b)=>({warn:0,ok:1,info:2}[a.state]-{warn:0,ok:1,info:2}[b.state]));
  $('#scs').textContent=pass+'/'+scored.length;
  $('#ring').style.setProperty('--p',scored.length?Math.round(pass/scored.length*100):0);
  $('#sverd').textContent=warns?warns+' thing'+(warns===1?'':'s')+' worth fixing':'Everything checks out';
  $('#scl').textContent=pass+' of '+scored.length+' checks passed';
  const pbd=$('#pbadge');pbd.hidden=false;pbd.textContent=pass+'/'+scored.length;pbd.className='badge '+(warns?'warn':'ok');
  const el=$('#sck');el.innerHTML='';
  c.forEach(t=>{const row=pxEl('div','px-step'),ic=pxEl('div','px-ic '+t.state,t.state==='ok'?'✓':t.state==='warn'?'!':'i');const b=pxEl('div');b.append(pxEl('b',null,t.name),pxEl('span',null,t.detail));row.append(ic,b);el.append(row)});
  $('#sci').innerHTML=[['strict','Strict','Blocks cookies and storage in frames'],['standard','Standard','Frames behave normally']].map(a=>`<button type="button" class="opt ${(PXS.isolate||'strict')===a[0]?'on':''}" data-iso="${a[0]}" style="flex-direction:column;align-items:flex-start;gap:2px"><b>${a[1]}</b><small>${a[2]}</small></button>`).join('');
  $('#sctn').textContent=pxList(PXS.block).length+' hosts blocked';
  let ck=[];try{ck=document.cookie?document.cookie.split(';').map(x=>x.split('=')[0].trim()).filter(Boolean):[]}catch(e){}
  let ls=0;try{ls=Object.keys(localStorage).filter(k=>k.startsWith('bh_')).length}catch(e){}
  $('#sca').innerHTML='<div class="px-step"><div class="px-ic '+(ck.length?'info':'ok')+'">'+(ck.length?'i':'✓')+'</div><div><b>Cookies</b><span>'+(ck.length?esc(ck.join(', ')):'None set by this page')+'</span></div></div>'+
    '<div class="px-step"><div class="px-ic info">i</div><div><b>Local storage</b><span>'+ls+' Phoenix item(s). Same-origin only, never sent to any server, not encrypted.</span></div></div>'+
    '<div class="px-step"><div class="px-ic ok">✓</div><div><b>Third-party cookies from the proxy</b><span>'+PXT.req+' request(s) this session, all made without credentials.</span></div></div>';
  const m=document.querySelector('meta[http-equiv="Content-Security-Policy"]'),pol=m?m.content.split(';').map(x=>x.trim()).filter(Boolean):[];
  $('#scp').innerHTML='<tr><th>Rule</th><th>What it means</th></tr>'+pol.map(p=>{const d=p.split(' ')[0];return '<tr><td>'+esc(p)+'</td><td>'+esc(SEC_CSP_INFO[d]||'')+'</td></tr>'}).join('');
  $('#scpin').textContent=cfg.pin?'A PIN is set. The lock screen appears on load and after the idle time you chose. It is stored as a salted hash, and five wrong attempts trigger a timed lockout. It is a screen lock, not encryption.':'No PIN is set. A PIN locks Phoenix behind a screen, useful if you share a device. You can also set an idle timeout so it locks itself.';
  secRenderViol();
}
function secRenderViol(){
  const el=$('#scv');
  el.innerHTML=SECV.length?SECV.map(v=>`<div class="px-row" style="grid-template-columns:62px 130px 1fr"><span>${v.t.toTimeString().slice(0,8)}</span><span class="px-badge BLOCKED">${esc(v.d)}</span><span class="u">${esc(v.u)}</span></div>`).join(''):'<span class="meta">Nothing blocked so far. If something tries to load a forbidden resource, it will appear here.</span>';
}
function secInit(){
  if(!secReady){
    secReady=true;
    $('#scr').onclick=secRender;
    $('#sci').onclick=e=>{const o=e.target.closest('[data-iso]');if(!o)return;PXS.isolate=o.dataset.iso;pxSave();secRender()};
    $('#sct').onclick=()=>{const cur=pxList(PXS.block),add=SEC_TRACKERS.filter(h=>!cur.includes(h));PXS.block=(PXS.block.trim()?PXS.block.trim()+'\n':'')+add.join('\n');pxSave();if(pxReady)pxRenderRules();secRender()};
    document.querySelector('[data-go-set]').onclick=()=>{go('set');setPane('lock')};
    document.querySelector('[data-goto-priv]').onclick=()=>{go('px');privTab('prot')};
  }
  secRender();
}

/* v3: recent searches, file backup, persistence */
const RS={
  get:()=>{const a=S.get('recent',[]);return Array.isArray(a)?a:[]},
  add(q){S.set('recent',[q,...RS.get().filter(x=>x!==q)].slice(0,8))},
  clear(){S.set('recent',[]);renderRecent()}
};
function renderRecent(){
  try{
    const a=RS.get(),el=$('#rec');if(!el)return;
    el.innerHTML=a.length?a.map(x=>`<button type="button" class="chip" data-q="${esc(x)}">${esc(x)}</button>`).join('')+'<button type="button" class="chip clr" data-clr="1">Clear</button>':'';
  }catch(e){}
}
$('#rec').onclick=e=>{
  const c=e.target.closest('.chip');if(!c)return;
  if(c.dataset.clr)return RS.clear();
  $('#q').value=c.dataset.q;doSearch();
};
renderRecent();
$('#exf').onclick=()=>{
  const b=new Blob([JSON.stringify({cfg:Object.assign({},cfg,{pin:''})})],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='phoenix-backup.json';a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1500);toast('Backup downloaded');
};
$('#imf').onchange=e=>{const f=e.target.files[0];if(!f)return;f.text().then(t=>{$('#bx').value=t;$('#im').click()});e.target.value=''};
addEventListener('pagehide',()=>{try{save()}catch(e){}});
try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}
secInit();
</script>
