<script>
const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const mem=Object.assign({}, window.__SEED||{});
const FROM_SEED=!!(window.__SEED && Object.keys(window.__SEED).length);
const S={
  get(k,d){
    if(FROM_SEED && mem[k]!=null){
      try{return JSON.parse(mem[k])}catch(e){return mem[k]}
    }
    let v=null;
    try{v=localStorage.getItem('bh_'+k)}catch(e){}
    if(v==null)v=mem[k];
    else mem[k]=v;
    try{return v==null?d:JSON.parse(v)}catch(e){return d}
  },
  set(k,v){
    v=JSON.stringify(v);mem[k]=v;
    try{localStorage.setItem('bh_'+k,v)}catch(e){}
  }
};
function syncSeed(){
  save();
