<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src https:; frame-src https:; base-uri 'none'; object-src 'none'; form-action 'none'; worker-src 'none'">
<meta name="referrer" content="no-referrer"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Phoenix</title>
<style>
:root{
  --acc:#6ee7a0;--acc2:#34d399;
  --bg:color-mix(in srgb,var(--acc) 4%,#07080c);
  --card:color-mix(in srgb,var(--acc) 5%,#12141a);
  --card2:color-mix(in srgb,var(--acc) 8%,#181b22);
  --bd:color-mix(in srgb,var(--acc) 16%,#252830);
  --bd2:color-mix(in srgb,var(--acc) 30%,#363a45);
  --text:#eef0f4;--mut:#9aa1b2;--on:#04110a;
  --ok:#4ade80;--warn:#fbbf24;--bad:#f87171;--info:#60a5fa;
  --rad:16px;--rad-sm:10px;
  --shadow:0 8px 30px #0006;
  --glass:blur(16px) saturate(1.4);
}
[data-m=light]{
  --bg:color-mix(in srgb,var(--acc) 8%,#f3f4f7);
  --card:#ffffffee;--card2:#fff;
  --bd:color-mix(in srgb,var(--acc) 28%,#d8dbe3);
  --bd2:color-mix(in srgb,var(--acc) 42%,#c0c5d1);
  --text:#12141a;--mut:#566073;--on:#04110a;
  --ok:#16a34a;--warn:#b45309;--bad:#dc2626;--info:#2563eb;
  --shadow:0 8px 30px #0001;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
html{scroll-behavior:smooth;color-scheme:dark}
html[data-m=light]{color-scheme:light}
body{
  font:15px/1.5 system-ui,"Segoe UI",sans-serif;
  background:var(--bg);color:var(--text);
  min-height:100vh;overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.03;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
body::after{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(900px 520px at 50% -8%,color-mix(in srgb,var(--acc) 15%,transparent),transparent 70%);
}
#bgi{position:fixed;inset:0;z-index:0;background-size:cover;background-position:center;display:none;opacity:.45}
#bgc{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.92}
#cg{position:fixed;width:280px;height:280px;margin:-140px;border-radius:50%;pointer-events:none;z-index:0;
  background:radial-gradient(circle,color-mix(in srgb,var(--acc) 16%,transparent),transparent 70%);
  opacity:.5}
[data-a=off] #cg{display:none}
::selection{background:color-mix(in srgb,var(--acc) 35%,transparent)}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
input:focus-visible,textarea:focus-visible{outline:0}
*{scrollbar-width:thin;scrollbar-color:var(--bd2) transparent}
button{font-family:inherit}

/* ───────── icons ───────── */
.i{width:1.2em;height:1.2em;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* ───────── navigation ───────── */
nav{
  position:fixed;top:max(16px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);
  display:flex;gap:4px;padding:5px;
  background:color-mix(in srgb,var(--card) 78%,transparent);
  border:1px solid var(--bd);border-radius:999px;
  backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  z-index:20;box-shadow:var(--shadow);
}
nav button{
  display:flex;align-items:center;gap:8px;
  border:0;background:none;color:var(--mut);
  padding:9px 18px;border-radius:999px;
  font:600 14px system-ui;cursor:pointer;transition:background .15s,color .15s,box-shadow .15s;
}
nav button:hover{color:var(--text);background:color-mix(in srgb,var(--text) 7%,transparent)}
nav button.on{background:var(--acc);color:var(--on);box-shadow:0 4px 16px color-mix(in srgb,var(--acc) 40%,transparent)}
nav button:active{transform:scale(.97)}

/* ───────── views ───────── */
.v{display:none;position:relative;z-index:1}
.v.on{display:block;animation:vin .28s ease both}
@keyframes vin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.page{max-width:960px;margin:0 auto;padding:96px 20px 72px}
.page-h{margin-bottom:22px}
.page-h h1{font-size:clamp(26px,4vw,34px);letter-spacing:-.8px;font-weight:800;line-height:1.15}
.page-h p{color:var(--mut);margin-top:6px;max-width:660px;font-size:15px}

/* ───────── shared components ───────── */
.panel{
  position:relative;background:var(--card);border:1px solid var(--bd);
  border-radius:var(--rad);padding:20px;margin-bottom:16px;
  box-shadow:inset 0 1px 0 #ffffff0d,0 4px 18px #0002;
  transition:border-color .2s;
}
.panel:hover{border-color:var(--bd2)}
.ph{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px}
.pico{flex:none;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--acc) 14%,transparent);color:var(--acc);font-size:17px}
.pt{font-size:16px;font-weight:700;letter-spacing:-.2px}
.pd{color:var(--mut);font-size:13.5px;margin-top:2px;line-height:1.5}
.sub{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--mut);margin:20px 0 8px}
.sub:first-child{margin-top:0}
.meta{font-size:12px;color:var(--mut)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:700px){.two{grid-template-columns:1fr}}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  border:1px solid var(--bd2);background:color-mix(in srgb,var(--text) 4%,transparent);color:var(--text);
  border-radius:var(--rad-sm);padding:10px 16px;font:600 13.5px system-ui;
  cursor:pointer;transition:border-color .15s,background .15s,transform .1s,filter .15s;text-decoration:none;
}
.btn:hover{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 10%,transparent)}
.btn:active{transform:scale(.97)}
.btn.pri{background:var(--acc);color:var(--on);border-color:var(--acc);box-shadow:0 4px 16px color-mix(in srgb,var(--acc) 28%,transparent)}
.btn.pri:hover{filter:brightness(1.08);background:var(--acc)}
.btn.danger{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 45%,transparent)}
.btn.danger:hover{background:color-mix(in srgb,var(--bad) 12%,transparent);border-color:var(--bad)}
.btn.sm{padding:7px 12px;font-size:12.5px}
.btn .i{font-size:16px}
.linkbtn{border:0;background:none;color:var(--acc);font-weight:600;font-family:inherit;font-size:inherit;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px}

.fld{display:grid;gap:6px}
.fld>label,.fld>span.l{font-size:12.5px;font-weight:600;color:var(--mut)}
.inp,select.inp,textarea.inp{
  width:100%;background:color-mix(in srgb,var(--bg) 55%,transparent);border:1px solid var(--bd);
  border-radius:var(--rad-sm);padding:11px 13px;color:var(--text);font:inherit;outline:0;
  transition:border-color .15s,box-shadow .15s;
}
.inp:focus{border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 18%,transparent)}
textarea.inp{min-height:84px;resize:vertical;font:12.5px ui-monospace,Menlo,Consolas,monospace}
select.inp option{background:var(--card2);color:var(--text)}

.opts{display:grid;gap:8px}
.opt{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:11px 13px;border-radius:var(--rad-sm);border:1px solid var(--bd);
  background:transparent;cursor:pointer;font:500 13.5px system-ui;color:var(--text);text-align:left;
  transition:border-color .15s,background .15s,transform .1s;
}
.opt:hover{border-color:var(--bd2);background:color-mix(in srgb,var(--acc) 6%,transparent)}
.opt:active{transform:scale(.98)}
.opt.on{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 13%,transparent);box-shadow:inset 0 0 0 1px var(--acc)}
.opt small{display:block;color:var(--mut);font-size:12px;font-weight:400}
.opt.c{justify-content:center;text-align:center}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:6px}

.tog{
  display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;
  padding:13px 15px;border:1px solid var(--bd);border-radius:var(--rad-sm);background:transparent;
  color:var(--text);cursor:pointer;text-align:left;font:inherit;transition:border-color .15s,background .15s;
}
.tog:hover{border-color:var(--bd2);background:color-mix(in srgb,var(--acc) 5%,transparent)}
.tog b{display:block;font-size:14px}
.tog small{display:block;color:var(--mut);font-size:12.5px;font-weight:400;margin-top:2px;line-height:1.4}
.tsw{flex:none;width:44px;height:26px;border-radius:99px;background:var(--bd2);position:relative;transition:background .2s}
.tsw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 3px #0005}
.tog.on .tsw{background:var(--acc)}
.tog.on .tsw::after{transform:translateX(18px)}

.swgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px}
.swt{
  position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;padding:13px 6px 10px;
  border:1px solid var(--bd);border-radius:var(--rad-sm);background:transparent;color:var(--text);cursor:pointer;
  font:600 12px system-ui;transition:border-color .15s,background .15s,transform .1s;
}
.swt i{width:30px;height:30px;border-radius:50%;background:var(--c);box-shadow:0 0 0 3px color-mix(in srgb,var(--c) 25%,transparent)}
.swt:hover{border-color:var(--bd2)}
.swt.on{border-color:var(--c);background:color-mix(in srgb,var(--c) 13%,transparent)}
.swt:active{transform:scale(.96)}
.swt input[type=color]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;border:0;padding:0}

kbd,.keycap{
  display:inline-flex;align-items:center;justify-content:center;min-width:44px;padding:9px 16px;
  border:1px solid var(--bd2);border-bottom-width:3px;border-radius:10px;
  background:var(--card2);color:var(--text);font:700 15px ui-monospace,Menlo,Consolas,monospace;
}
button.keycap{cursor:pointer}
button.keycap:hover{border-color:var(--acc)}
button.keycap.listen{border-color:var(--acc);color:var(--acc);animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{box-shadow:0 0 0 5px color-mix(in srgb,var(--acc) 25%,transparent)}}

code{font:12.5px ui-monospace,Menlo,Consolas,monospace;background:color-mix(in srgb,var(--text) 8%,transparent);padding:1px 6px;border-radius:6px}

.tabs{display:flex;gap:4px;padding:4px;background:color-mix(in srgb,var(--card) 70%,transparent);border:1px solid var(--bd);border-radius:999px;width:max-content;max-width:100%;overflow-x:auto;margin-bottom:20px}
.tabs button{display:flex;align-items:center;gap:7px;border:0;background:none;color:var(--mut);padding:9px 16px;border-radius:999px;font:600 13.5px system-ui;cursor:pointer;white-space:nowrap;transition:color .15s,background .15s}
.tabs button:hover{color:var(--text)}
.tabs button.on{background:color-mix(in srgb,var(--acc) 18%,transparent);color:var(--text);box-shadow:inset 0 0 0 1px var(--acc)}
.badge{font-size:11px;padding:1px 8px;border-radius:99px;background:var(--bd);color:var(--text);font-weight:700}
.badge.ok{background:color-mix(in srgb,var(--ok) 25%,transparent);color:var(--ok)}
.badge.warn{background:color-mix(in srgb,var(--warn) 25%,transparent);color:var(--warn)}
.pt-pane,.set-pane{display:none}
.pt-pane.on,.set-pane.on{display:block;animation:vin .25s ease both}

details.acc{border:1px solid var(--bd);border-radius:var(--rad);background:var(--card);margin-bottom:10px;overflow:hidden;transition:border-color .2s}
details.acc:hover{border-color:var(--bd2)}
details.acc>summary{cursor:pointer;padding:15px 18px;font-weight:700;font-size:14.5px;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
details.acc>summary::-webkit-details-marker{display:none}
details.acc>summary::after{content:"+";color:var(--acc);font-size:22px;font-weight:400;line-height:1}
details.acc[open]>summary::after{content:"–"}
details.acc>.body{padding:0 18px 18px}

#toast{
  position:fixed;left:50%;bottom:28px;transform:translate(-50%,20px);z-index:200;
  background:var(--card2);border:1px solid var(--acc);color:var(--text);
  padding:11px 20px;border-radius:999px;font:600 13.5px system-ui;box-shadow:var(--shadow);
  opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;max-width:calc(100vw - 32px);text-align:center;
}
#toast.on{opacity:1;transform:translate(-50%,0)}

/* ───────── home ───────── */
#v-home{
  min-height:100vh;display:none;flex-direction:column;
  align-items:center;justify-content:center;
  padding:90px 20px 50px;
}
#v-home.on{display:flex}
.home-logo{
  position:relative;width:96px;height:96px;border-radius:28px;
  display:grid;place-items:center;font-size:46px;margin-bottom:18px;
  background:color-mix(in srgb,var(--card) 70%,transparent);
  border:1px solid var(--bd2);
  box-shadow:0 0 0 7px color-mix(in srgb,var(--acc) 8%,transparent),0 14px 44px color-mix(in srgb,var(--acc) 24%,transparent);
  overflow:hidden;animation:float 5s ease-in-out infinite;transition:transform .3s;
}
@keyframes float{50%{translate:0 -7px}}
.home-logo:hover{transform:rotate(-5deg) scale(1.06)}
.home-logo img{width:100%;height:100%;object-fit:cover}
.home-title{
  font-size:clamp(42px,9vw,76px);font-weight:800;letter-spacing:-2px;line-height:1;
  margin-bottom:12px;display:flex;justify-content:center;flex-wrap:wrap;
}
.home-title span{display:inline-block;animation:rise .6s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i,0)*45ms)}
.home-title .a{color:var(--acc);text-shadow:0 0 38px color-mix(in srgb,var(--acc) 55%,transparent)}
@keyframes rise{from{opacity:0;transform:translateY(16px)}}
[data-a=off] .home-logo,[data-a=off] .home-title span{animation:none}
.home-hello{color:var(--mut);font-size:15px;margin-bottom:28px;text-align:center}
.home-search{
  width:min(620px,100%);
  display:flex;align-items:center;gap:12px;
  background:var(--card);border:1px solid var(--bd2);
  border-radius:999px;padding:6px 8px 6px 22px;
  transition:border-color .2s,box-shadow .2s;
  box-shadow:0 4px 18px #0003;
}
.home-search:hover{box-shadow:0 6px 24px #0004}
.home-search:focus-within{border-color:var(--acc);box-shadow:0 6px 28px #0004,0 0 0 4px color-mix(in srgb,var(--acc) 20%,transparent)}
.home-search .si{flex:none;color:var(--mut);display:grid;place-items:center;font-size:20px}
.home-search input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--text);font:17px system-ui;padding:14px 0}
.home-search input::placeholder{color:var(--mut);opacity:.75}
.home-search button{
  border:0;background:var(--acc);color:var(--on);
  font:700 14px system-ui;padding:12px 24px;border-radius:999px;
  cursor:pointer;flex:none;transition:filter .15s,transform .15s;
}
.home-search button:hover{filter:brightness(1.08)}
.home-search button:active{transform:scale(.96)}
.home-meta{margin-top:14px;font-size:13px;color:var(--mut);display:flex;gap:6px;align-items:center;justify-content:center;flex-wrap:wrap;text-align:center}
.home-meta b{color:var(--text);font-weight:600}
.recent{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:18px;width:min(620px,100%)}
.recent:empty{display:none}
.chip{border:1px solid var(--bd);background:color-mix(in srgb,var(--card) 70%,transparent);color:var(--mut);
  font:500 12.5px system-ui;padding:6px 13px;border-radius:999px;cursor:pointer;max-width:200px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;transition:color .15s,border-color .15s}
.chip:hover{color:var(--text);border-color:var(--acc)}
.chip.clr{border-style:dashed}
.home-links{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:36px;max-width:620px}
.home-links a{
  width:96px;padding:15px 6px 12px;text-align:center;text-decoration:none;color:var(--text);
  font-size:12.5px;font-weight:600;border:1px solid var(--bd);border-radius:var(--rad);
  background:color-mix(in srgb,var(--card) 70%,transparent);backdrop-filter:blur(8px);
  transition:transform .18s,border-color .18s,box-shadow .18s;
}
.home-links .ic{
  width:46px;height:46px;margin:0 auto 9px;border-radius:14px;display:grid;place-items:center;
  color:var(--c,var(--acc));background:color-mix(in srgb,var(--c,var(--acc)) 15%,transparent);font-size:22px;
}
.home-links a:hover{transform:translateY(-4px);border-color:var(--c,var(--acc));box-shadow:0 10px 26px color-mix(in srgb,var(--c,var(--acc)) 25%,transparent)}

/* ───────── settings ───────── */
.set-wrap{display:grid;grid-template-columns:220px 1fr;gap:24px;align-items:start}
.set-side{position:sticky;top:90px;display:grid;gap:4px;padding:8px;background:var(--card);border:1px solid var(--bd);border-radius:var(--rad)}
.set-side button{display:flex;align-items:center;gap:11px;border:0;background:none;color:var(--mut);padding:11px 12px;border-radius:var(--rad-sm);font:600 14px system-ui;cursor:pointer;text-align:left;transition:color .15s,background .15s}
.set-side button .i{font-size:18px}
.set-side button:hover{color:var(--text);background:color-mix(in srgb,var(--text) 6%,transparent)}
.set-side button.on{color:var(--text);background:color-mix(in srgb,var(--acc) 16%,transparent);box-shadow:inset 3px 0 0 var(--acc)}
.pane-h{margin-bottom:16px}
.pane-h h2{font-size:20px;font-weight:800;letter-spacing:-.4px}
.pane-h p{color:var(--mut);font-size:14px;margin-top:2px}
.range-row{display:flex;align-items:center;gap:12px}
.range-row input[type=range]{flex:1;accent-color:var(--acc)}
#radv{font-size:13px;color:var(--mut);min-width:30px;text-align:right}
.tabprev{display:flex;align-items:center;gap:9px;padding:9px 14px;border:1px solid var(--bd);border-bottom:0;border-radius:12px 12px 0 0;background:var(--card2);width:min(280px,100%);font-size:13px;margin-top:4px}
.tabprev img{width:16px;height:16px;border-radius:4px;flex:none}
.tabprev span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tabprev-bar{height:6px;background:var(--card2);border:1px solid var(--bd);border-radius:0 6px 6px 6px;margin-bottom:12px}
.danger-zone{border-color:color-mix(in srgb,var(--bad) 45%,var(--bd))}
.danger-zone:hover{border-color:var(--bad)}

/* background picker */
.bg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}
.bgcard{
  position:relative;display:block;border:2px solid var(--bd);border-radius:var(--rad-sm);padding:0;
  background:var(--card2);cursor:pointer;overflow:hidden;color:var(--text);text-align:left;
  transition:transform .15s,border-color .15s,box-shadow .15s;
}
.bgcard:hover{transform:translateY(-3px);border-color:var(--bd2);box-shadow:0 10px 24px #0005}
.bgcard:active{transform:scale(.98)}
.bgcard.on{border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 25%,transparent)}
.bgthumb{display:block;width:100%;aspect-ratio:8/5;background:var(--bg)}
.bgplain{display:block;width:100%;aspect-ratio:8/5;background:var(--bg);background-image:linear-gradient(45deg,color-mix(in srgb,var(--text) 5%,transparent) 25%,transparent 25%,transparent 75%,color-mix(in srgb,var(--text) 5%,transparent) 75%);background-size:14px 14px}
.bgmeta{display:flex;justify-content:space-between;align-items:center;padding:9px 11px;gap:6px}
.bgmeta b{font-size:13.5px}
.bgmeta small{color:var(--mut);font-size:11.5px}
.bgcard .chk{position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;background:var(--acc);color:var(--on);display:none;place-items:center;font-size:14px;font-weight:800;box-shadow:0 2px 8px #0006}
.bgcard.on .chk{display:grid}
.upl{
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:18px;
  border:2px dashed color-mix(in srgb,var(--acc) 55%,var(--bd));border-radius:var(--rad);
  background:color-mix(in srgb,var(--acc) 6%,transparent);transition:background .15s,border-color .15s;
}
.upl:hover,.upl.drag{background:color-mix(in srgb,var(--acc) 13%,transparent);border-color:var(--acc)}
.upl.on{border-style:solid;border-color:var(--acc)}
.upl-ico{width:72px;height:72px;border-radius:16px;display:grid;place-items:center;background:color-mix(in srgb,var(--acc) 18%,transparent);color:var(--acc);background-size:cover;background-position:center;flex:none;font-size:30px;border:1px solid var(--bd2)}
.upl-txt{flex:1;min-width:200px}
.upl-txt b{display:block;font-size:15px}
.upl-txt small{color:var(--mut);font-size:13px;line-height:1.4;display:block;margin-top:2px}

/* ───────── privacy page ───────── */
.usecards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
@media(max-width:700px){.usecards{grid-template-columns:1fr}}
.uc{border:1px solid var(--bd);border-radius:var(--rad);padding:16px 18px;background:var(--card)}
.uc b{display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:8px}
.uc.good{border-color:color-mix(in srgb,var(--ok) 40%,var(--bd))}
.uc.good b{color:var(--ok)}
.uc.bad{border-color:color-mix(in srgb,var(--bad) 35%,var(--bd))}
.uc.bad b{color:var(--bad)}
.uc ul{list-style:none;display:grid;gap:5px}
.uc li{font-size:13.5px;color:var(--mut);padding-left:16px;position:relative;line-height:1.45}
.uc li::before{content:"•";position:absolute;left:3px}
.px-flow{display:flex;flex-wrap:wrap;align-items:stretch;gap:6px;margin:4px 0 14px}
.px-node{padding:8px 11px;border:1px solid var(--bd);border-radius:var(--rad-sm);background:var(--card2);font-size:12px;font-weight:600}
.px-node small{display:block;font-weight:400;color:var(--mut);font-size:11px;margin-top:2px}
.px-node.core{border-color:var(--acc)}
.px-arrow{color:var(--acc);font-weight:700;align-self:center}
.px-bar{display:flex;gap:8px;margin:14px 0 8px}
.px-bar input{flex:1;min-width:0}
.px-bar button{padding:0 26px}
.px-modes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
@media(max-width:700px){.px-modes{grid-template-columns:1fr}}
.px-modes .opt{flex-direction:column;align-items:flex-start;gap:3px;padding:13px 14px}
.px-modes .opt b{font-size:14px;display:flex;align-items:center;gap:8px}
.px-modes .opt small{color:var(--mut);font-size:12px;line-height:1.4}
.px-modes .opt .when{font-size:11.5px;color:var(--acc);font-weight:600;margin-top:3px}
.px-ex{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 0;align-items:center;font-size:12.5px;color:var(--mut)}
.px-ex button{border:1px solid var(--bd);background:transparent;color:var(--text);padding:6px 12px;border-radius:999px;font:12.5px system-ui;cursor:pointer;transition:border-color .15s}
.px-ex button:hover{border-color:var(--acc)}
.px-step{display:flex;gap:10px;padding:10px 0;border-top:1px solid var(--bd);font-size:13px;line-height:1.45}
.px-step:first-child{border-top:0}
.px-ic{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:700;flex-shrink:0;margin-top:1px}
.px-ic.ok{background:var(--ok);color:#04110a}
.px-ic.fail{background:var(--bad);color:#220808}
.px-ic.skip{background:var(--bd);color:var(--mut)}
.px-ic.warn{background:var(--warn);color:#221a05}
.px-ic.info{background:var(--info);color:#05121f}
.px-step b{display:block;font-size:13.5px}
.px-step span{color:var(--mut);word-break:break-word}
.px-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
@media(max-width:600px){.px-stats{grid-template-columns:repeat(3,1fr)}}
.px-stat{border:1px solid var(--bd);border-radius:var(--rad-sm);padding:10px 12px;background:var(--card2)}
.px-stat b{display:block;font-size:22px;color:var(--acc)}
.px-stat span{font-size:11.5px;color:var(--mut)}
.px-res h4{font-size:16px;margin:0 0 4px}
.px-res p{margin:6px 0;line-height:1.55;font-size:14px}
.px-item{padding:10px 0;border-top:1px solid var(--bd)}
.px-item:first-of-type{border-top:0}
.px-link{color:var(--acc);cursor:pointer;font-weight:600;text-decoration:none;background:none;border:0;font:600 14px system-ui;padding:0;text-align:left}
.px-link:hover{text-decoration:underline}
.px-err{border:1px solid var(--bad);border-radius:var(--rad-sm);padding:14px;font-size:13.5px;line-height:1.5;background:color-mix(in srgb,var(--bad) 8%,transparent)}
.px-frame{width:100%;height:68vh;border:1px solid var(--bd);border-radius:var(--rad-sm);background:#fff;margin-top:10px}
.px-log{font:12px ui-monospace,Menlo,Consolas,monospace;max-height:260px;overflow:auto}
.px-row{display:grid;grid-template-columns:62px 58px 74px 1fr;gap:8px;padding:6px 0;border-top:1px solid var(--bd);align-items:baseline}
.px-row:first-child{border-top:0}
.px-row .u{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--mut)}
.px-badge{font-weight:700}
.px-badge.HIT{color:var(--info)}.px-badge.FETCHED{color:var(--ok)}.px-badge.BLOCKED,.px-badge.ERROR{color:var(--bad)}.px-badge.FRAME{color:var(--warn)}
.px-help{font-size:13px;color:var(--mut);line-height:1.55;margin:0 0 10px}
.px-doc h4{font-size:14px;margin:16px 0 6px}
.px-doc h4:first-child{margin-top:0}
.px-doc p,.px-doc li{font-size:13.5px;color:var(--mut);line-height:1.6}
.px-doc ul,.px-doc ol{padding-left:20px}
.px-doc strong{color:var(--text)}
.px-doc table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:6px}
.px-doc th,.px-doc td{border:1px solid var(--bd);padding:7px 9px;text-align:left;vertical-align:top}
.px-doc th{color:var(--text)}
.sec-top{display:flex;align-items:center;gap:18px;margin-bottom:10px}
.ring{--p:0;position:relative;flex:none;width:88px;height:88px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--acc) calc(var(--p)*1%),var(--bd) 0)}
.ring::after{content:"";position:absolute;inset:8px;border-radius:50%;background:var(--card)}
.ring b{position:relative;z-index:1;font-size:19px}
.sec-verdict{font-size:17px;font-weight:700}
.sec-tbl{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:6px}
.sec-tbl th,.sec-tbl td{border:1px solid var(--bd);padding:7px 9px;text-align:left;vertical-align:top}
.sec-tbl th{color:var(--text)}
.sec-tbl td:first-child{font-family:ui-monospace,Menlo,Consolas,monospace;white-space:nowrap}
.sec-tbl td{color:var(--mut)}
.sec-layers{display:grid;gap:8px;margin:8px 0 4px}
.sec-layer{border:1px solid var(--bd);border-radius:var(--rad-sm);padding:12px 14px;background:var(--card2);font-size:13px;line-height:1.5}
.sec-layer b{display:block;color:var(--text);font-size:13.5px}
.sec-layer span{color:var(--mut)}
.sec-layer em{font-style:normal;font-size:11px;font-weight:700;color:var(--acc);text-transform:uppercase;letter-spacing:.5px}

/* ───────── lock screen ───────── */
#lk{display:none;position:fixed;inset:0;z-index:100;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);place-items:center;padding:20px}
#lk.on{display:grid}
.lockbox{text-align:center;width:min(340px,100%);padding:28px;margin:0}
.lockbox .pico{margin:0 auto 12px;width:52px;height:52px;font-size:24px;border-radius:16px}
.lockbox .inp{margin:16px 0 10px;text-align:center}
#lm{display:block;min-height:18px;color:var(--bad);font-size:13px;margin-bottom:8px}

/* ───────── surface styles ───────── */
[data-card=glass] .panel,[data-card=glass] .home-search,[data-card=glass] .home-logo,[data-card=glass] .home-links a,[data-card=glass] details.acc,[data-card=glass] .uc,[data-card=glass] .set-side{
  background:color-mix(in srgb,var(--card) 55%,transparent);
  backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
}
[data-card=sharp] .panel,[data-card=sharp] .home-search,[data-card=sharp] .home-logo,[data-card=sharp] .home-links a,[data-card=sharp] .opt,[data-card=sharp] details.acc,[data-card=sharp] .uc,[data-card=sharp] .bgcard,[data-card=sharp] .set-side{border-radius:6px}
[data-card=soft] .panel,[data-card=soft] .home-search,[data-card=soft] details.acc,[data-card=soft] .uc,[data-card=soft] .set-side{border-radius:24px}

/* ───────── responsive ───────── */
@media(max-width:760px){
  .set-wrap{grid-template-columns:1fr;gap:14px}
  .set-side{position:static;display:flex;overflow-x:auto;padding:6px}
  .set-side button{white-space:nowrap;padding:9px 13px}
  .set-side button.on{box-shadow:inset 0 -3px 0 var(--acc)}
}
@media(max-width:640px){
  nav{top:auto;bottom:max(12px,env(safe-area-inset-bottom));left:12px;right:12px;transform:none;justify-content:space-around}
  nav button{flex:1;justify-content:center;flex-direction:column;gap:3px;padding:8px 6px;font-size:11.5px;border-radius:18px}
  nav button .i{font-size:20px}
  .page{padding:28px 16px 110px}
  #v-home{padding:40px 16px 120px}
  #toast{bottom:92px}
  .home-links{gap:10px}
  .home-links a{width:86px}
  .home-search{padding-left:16px}
  .home-search button{padding:12px 18px}
  .px-bar button{padding:0 18px}
}
@media(prefers-reduced-motion:reduce){.v.on,.pt-pane.on,.set-pane.on{animation:none}*{transition-duration:.01ms!important;animation:none!important}}
</style>
</head>
<body>
